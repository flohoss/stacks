{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "assignees": ["flohoss"],
  "prHourlyLimit": 0,
  "dependencyDashboard": false,
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "docker.io/valkey/valkey",
        "ghcr.io/immich-app/postgres"
      ],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["redis"],
      "allowedVersions": "8.x"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "allowedVersions": "17.x"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mariadb"],
      "allowedVersions": "10.x"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["cryptpad/cryptpad"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "extractVersion": "^version-(?<version>.+)$"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-machine-learning",
        "ghcr.io/immich-app/immich-server"
      ],
      "groupName": "Immich",
      "groupSlug": "immich",
      "separateMinorPatch": false,
      "separateMultipleMajor": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "dock.mau.dev/mautrix/signal",
        "dock.mau.dev/mautrix/telegram",
        "dock.mau.dev/mautrix/whatsapp",
        "dock.mau.dev/mautrix/meta"
      ],
      "groupName": "Mautrix",
      "groupSlug": "mautrix",
      "separateMinorPatch": false,
      "separateMultipleMajor": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/dongdongbh/mindwtr-cloud",
        "ghcr.io/dongdongbh/mindwtr-app"
      ],
      "groupName": "Mindwtr",
      "groupSlug": "mindwtr",
      "separateMinorPatch": false,
      "separateMultipleMajor": false
    },
    {
      "matchDatasources": ["docker"],
      "pinDigests": true
    }
  ]
}
